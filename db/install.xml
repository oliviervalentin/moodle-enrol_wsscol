<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="enrol/wsscol/db" VERSION="20240528" COMMENT="XMLDB file for Moodle enrol/wsscol"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="enrol_wsscol_scolapps" COMMENT="Webservices parameters for each schools applications">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false" COMMENT="name"/>
        <FIELD NAME="wshost" TYPE="char" LENGTH="253" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="wsuser" TYPE="char" LENGTH="128" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="wspassword" TYPE="char" LENGTH="128" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="baseurl" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="if baseurl is null, *_uri should be complete"/>
        <FIELD NAME="getstudents_uri" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="getstudent_id_ws" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false" COMMENT="webservice field id"/>
        <FIELD NAME="getstudent_id_local" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false" COMMENT="local id to map"/>
        <FIELD NAME="searchgroups_uri" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="searchgroups_code_ws" TYPE="char" LENGTH="16" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="searchgroups_name_ws" TYPE="char" LENGTH="16" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="int" LENGTH="1" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="role" TYPE="int" LENGTH="2" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="id" TYPE="primary" FIELDS="id" COMMENT="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
